{
  "bsonType": "object",
  "required": [
    "teacher_id",
    "amount",
    "method"
  ],
  "permission": {
    "read": "(doc.teacher_id == auth.uid) || 'admin' in auth.role || 'auditor' in auth.role",
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "提现申请ID"
    },
    "teacher_id": {
      "bsonType": "string",
      "description": "教师用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "amount": {
      "bsonType": "number",
      "description": "提现金额（元）",
      "minimum": 0
    },
    "method": {
      "bsonType": "string",
      "description": "提现方式",
      "defaultValue": "wxpay"
    },
    "remark": {
      "bsonType": "string",
      "description": "备注"
    },
    "appointment_id": {
      "bsonType": "string",
      "description": "关联预约ID（课程结算自动到账）"
    },
    "source": {
      "bsonType": "string",
      "description": "来源：manual/auto_settle"
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "pending",
        "wait_confirm",
        "completed",
        "failed"
      ],
      "description": "申请状态",
      "defaultValue": "pending"
    },
    "out_bill_no": {
      "bsonType": "string",
      "description": "商户转账单号"
    },
    "package_info": {
      "bsonType": "string",
      "description": "待用户确认收款时的 package"
    },
    "payment_time": {
      "bsonType": "timestamp",
      "description": "打款时间"
    },
    "payment_no": {
      "bsonType": "string",
      "description": "打款单号"
    },
    "fail_reason": {
      "bsonType": "string",
      "description": "失败原因"
    },
    "create_time": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "update_time": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
