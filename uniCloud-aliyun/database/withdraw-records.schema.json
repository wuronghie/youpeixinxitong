{
  "bsonType": "object",
  "required": [
    "teacher_id",
    "amount"
  ],
  "permission": {
    "read": "(doc.teacher_id == auth.uid) || 'admin' in auth.role || 'auditor' in auth.role",
    "create": "auth.uid != null",
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "提现记录ID"
    },
    "withdraw_no": {
      "bsonType": "string",
      "description": "提现单号"
    },
    "teacher_id": {
      "bsonType": "string",
      "description": "教师用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "amount": {
      "bsonType": "number",
      "description": "提现金额",
      "minimum": 0
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "pending",
        "processing",
        "success",
        "failed"
      ],
      "description": "提现状态",
      "defaultValue": "pending"
    },
    "account_info": {
      "bsonType": "object",
      "description": "收款账户信息",
      "properties": {
        "type": {
          "bsonType": "string",
          "enum": [
            "wxpay",
            "alipay",
            "bank"
          ],
          "description": "账户类型"
        },
        "account": {
          "bsonType": "string",
          "description": "账户号"
        },
        "name": {
          "bsonType": "string",
          "description": "账户名"
        }
      }
    },
    "fail_reason": {
      "bsonType": "string",
      "description": "失败原因"
    },
    "complete_time": {
      "bsonType": "timestamp",
      "description": "完成时间"
    },
    "create_time": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
