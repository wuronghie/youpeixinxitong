{
  "bsonType": "object",
  "required": [
    "appointment_id",
    "parent_id",
    "teacher_id"
  ],
  "permission": {
    "read": "(doc.parent_id == auth.uid || doc.teacher_id == auth.uid) || 'admin' in auth.role || 'auditor' in auth.role",
    "create": false,
    "update": "doc.parent_id == auth.uid || doc.teacher_id == auth.uid",
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "会话ID"
    },
    "appointment_id": {
      "bsonType": "string",
      "description": "关联的预约ID",
      "foreignKey": "appointments._id"
    },
    "parent_id": {
      "bsonType": "string",
      "description": "家长用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "teacher_id": {
      "bsonType": "string",
      "description": "教师用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "chat_enabled": {
      "bsonType": "bool",
      "description": "是否允许聊天（教师支付信息费后为true；旧字段保留 deposit 命名）",
      "defaultValue": false
    },
    "teacher_deposit_paid": {
      "bsonType": "bool",
      "description": "教师是否已支付信息费（= hourly_rate × 2，旧字段名 deposit 保留兼容）",
      "defaultValue": false
    },
    "last_message": {
      "bsonType": "object",
      "description": "最后一条消息",
      "properties": {
        "content": {
          "bsonType": "string",
          "description": "消息内容"
        },
        "type": {
          "bsonType": "string",
          "enum": [
            "text",
            "image",
            "voice",
            "location"
          ],
          "description": "消息类型"
        },
        "send_time": {
          "bsonType": "timestamp",
          "description": "发送时间"
        },
        "sender_id": {
          "bsonType": "string",
          "description": "发送者ID"
        }
      }
    },
    "unread_count": {
      "bsonType": "object",
      "description": "未读消息数",
      "properties": {
        "parent": {
          "bsonType": "int",
          "description": "家长未读数",
          "defaultValue": 0
        },
        "teacher": {
          "bsonType": "int",
          "description": "教师未读数",
          "defaultValue": 0
        }
      }
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "active",
        "archived"
      ],
      "description": "会话状态",
      "defaultValue": "active"
    },
    "create_time": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "update_time": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
