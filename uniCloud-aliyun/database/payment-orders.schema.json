{
  "bsonType": "object",
  "required": [
    "order_no",
    "order_type"
  ],
  "permission": {
    "read": "(doc.payer_id == auth.uid || doc.teacher_id == auth.uid || doc.parent_id == auth.uid) || 'admin' in auth.role || 'auditor' in auth.role",
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "订单ID"
    },
    "order_no": {
      "bsonType": "string",
      "description": "订单号"
    },
    "appointment_id": {
      "bsonType": "string",
      "description": "关联的预约ID",
      "foreignKey": "appointments._id"
    },
    "parent_id": {
      "bsonType": "string",
      "description": "家长用户ID（兼容字段）",
      "foreignKey": "uni-id-users._id"
    },
    "payer_id": {
      "bsonType": "string",
      "description": "支付人用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "teacher_id": {
      "bsonType": "string",
      "description": "教师用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "order_type": {
      "bsonType": "string",
      "enum": [
        "course_fee",
        "deposit",
        "trial",
        "regular",
        "teacher_deposit"
      ],
      "description": "订单类型：course_fee-课程费，deposit-教师信息费（旧名保留，语义=hourly_rate×2 的一节试课费用），trial-试课，regular-正式课程，teacher_deposit-教师保证金（旧版）"
    },
    "fee_kind": {
      "bsonType": "string",
      "enum": [
        "course_fee",
        "info_fee",
        "refund"
      ],
      "description": "业务用途：course_fee-课程费，info_fee-教师信息费，refund-退款。用于区分 order_type=deposit 的新旧语义。"
    },
    "info_fee_refunded": {
      "bsonType": "bool",
      "description": "信息费是否已退回教师钱包（试课失败时置 true）",
      "defaultValue": false
    },
    "info_fee_refund_amount": {
      "bsonType": "number",
      "description": "已退回的信息费金额（元）",
      "minimum": 0
    },
    "info_fee_refund_time": {
      "bsonType": "timestamp",
      "description": "信息费退回时间"
    },
    "amount": {
      "bsonType": "number",
      "description": "实际支付金额（元，已扣除优惠）",
      "minimum": 0
    },
    "total_amount": {
      "bsonType": "number",
      "description": "原订单总金额（元，未扣除优惠）",
      "minimum": 0
    },
    "original_amount": {
      "bsonType": "number",
      "description": "原价金额（元，与 total_amount 含义相同，兼容字段）",
      "minimum": 0
    },
    "discount_amount": {
      "bsonType": "number",
      "description": "优惠金额（元）",
      "minimum": 0
    },
    "user_coupon_id": {
      "bsonType": "string",
      "description": "使用的用户优惠券记录ID",
      "foreignKey": "user-coupons._id"
    },
    "coupon_id": {
      "bsonType": "string",
      "description": "优惠券模板ID",
      "foreignKey": "coupons._id"
    },
    "platform_fee_rate": {
      "bsonType": "number",
      "description": "平台费率",
      "minimum": 0,
      "maximum": 1
    },
    "platform_fee": {
      "bsonType": "number",
      "description": "平台手续费"
    },
    "teacher_income": {
      "bsonType": "number",
      "description": "教师实际收入"
    },
    "deposit_status": {
      "bsonType": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded",
        "forfeited"
      ],
      "description": "保证金状态（仅教师保证金订单）"
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "pending",
        "unpaid",
        "paid",
        "success",
        "refunding",
        "refunded",
        "settled",
        "cancelled"
      ],
      "description": "订单状态：pending-待支付，unpaid-未支付，paid-已支付，success-支付成功，refunding-退款中，refunded-已退款，settled-已结算，cancelled-已取消",
      "defaultValue": "pending"
    },
    "out_trade_no": {
      "bsonType": "string",
      "description": "商户订单号（uni-pay）"
    },
    "uni_pay_order_no": {
      "bsonType": "string",
      "description": "uni-pay订单号"
    },
    "refund_amount": {
      "bsonType": "number",
      "description": "退款金额（元）",
      "minimum": 0
    },
    "refund_reason": {
      "bsonType": "string",
      "description": "退款原因"
    },
    "refund_request_id": {
      "bsonType": "string",
      "description": "退款申请ID",
      "foreignKey": "payment-refunds._id"
    },
    "channel": {
      "bsonType": "string",
      "description": "支付渠道",
      "defaultValue": "wxpay"
    },
    "payment_method": {
      "bsonType": "string",
      "description": "支付方式"
    },
    "payment_time": {
      "bsonType": "timestamp",
      "description": "支付时间"
    },
    "transaction_id": {
      "bsonType": "string",
      "description": "交易号"
    },
    "payment_notify_payload": {
      "bsonType": "object",
      "description": "支付通知原始数据"
    },
    "pay_info": {
      "bsonType": "object",
      "description": "支付信息（兼容字段）",
      "properties": {
        "provider": {
          "bsonType": "string",
          "description": "支付提供商",
          "defaultValue": "wxpay"
        },
        "transaction_id": {
          "bsonType": "string",
          "description": "微信交易号"
        },
        "pay_time": {
          "bsonType": "timestamp",
          "description": "支付时间"
        }
      }
    },
    "refund_info": {
      "bsonType": "object",
      "description": "退款信息（兼容字段）",
      "properties": {
        "refund_amount": {
          "bsonType": "number",
          "description": "退款金额"
        },
        "refund_reason": {
          "bsonType": "string",
          "description": "退款原因"
        },
        "refund_time": {
          "bsonType": "timestamp",
          "description": "退款时间"
        },
        "refund_transaction_id": {
          "bsonType": "string",
          "description": "退款交易号"
        }
      }
    },
    "settlement_info": {
      "bsonType": "object",
      "description": "结算信息",
      "properties": {
        "settlement_time": {
          "bsonType": "timestamp",
          "description": "结算时间"
        },
        "settlement_amount": {
          "bsonType": "number",
          "description": "结算金额"
        }
      }
    },
    "create_time": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "update_time": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
