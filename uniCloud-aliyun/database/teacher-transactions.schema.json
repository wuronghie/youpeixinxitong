{
  "bsonType": "object",
  "required": [
    "teacher_id",
    "type",
    "amount"
  ],
  "permission": {
    "read": "(doc.teacher_id == auth.uid) || 'admin' in auth.role || 'auditor' in auth.role",
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "流水ID"
    },
    "teacher_id": {
      "bsonType": "string",
      "description": "教师用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "appointment_id": {
      "bsonType": "string",
      "description": "关联预约ID",
      "foreignKey": "appointments._id"
    },
    "type": {
      "bsonType": "string",
      "enum": [
        "income",
        "withdraw",
        "refund"
      ],
      "description": "流水类型"
    },
    "title": {
      "bsonType": "string",
      "description": "流水标题"
    },
    "description": {
      "bsonType": "string",
      "description": "流水说明"
    },
    "amount": {
      "bsonType": "number",
      "description": "变动金额（元）"
    },
    "status": {
      "bsonType": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "description": "流水状态",
      "defaultValue": "completed"
    },
    "source": {
      "bsonType": "string",
      "description": "来源标识"
    },
    "relate_id": {
      "bsonType": "string",
      "description": "关联业务ID"
    },
    "create_time": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "update_time": {
      "bsonType": "timestamp",
      "description": "更新时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
