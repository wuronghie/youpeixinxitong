<view class="attendance-progress"><view class="attendance-progress__header"><text class="attendance-progress__title">老师打卡进度</text><text class="{{['attendance-progress__hint', b]}}">{{a}}</text></view><view class="attendance-progress__steps"><view class="{{['attendance-progress__step', g && 'is-done', h && 'is-active']}}"><view class="attendance-progress__dot"></view><view class="attendance-progress__step-body"><text class="attendance-progress__step-title">上课打卡</text><text wx:if="{{c}}" class="attendance-progress__step-time">{{d}}</text><text wx:else class="attendance-progress__step-time attendance-progress__step-time--muted"> 由老师完成上课打卡 </text><text wx:if="{{e}}" class="attendance-progress__step-addr"> 位置：{{f}}</text></view></view><view class="{{['attendance-progress__line', i && 'is-done']}}"></view><view class="{{['attendance-progress__step', n && 'is-done', o && 'is-active']}}"><view class="attendance-progress__dot"></view><view class="attendance-progress__step-body"><text class="attendance-progress__step-title">下课打卡</text><text wx:if="{{j}}" class="attendance-progress__step-time">{{k}}</text><text wx:else class="attendance-progress__step-time attendance-progress__step-time--muted"> 老师完成下课打卡后，您可确认结果 </text><text wx:if="{{l}}" class="attendance-progress__step-addr"> 位置：{{m}}</text></view></view></view><view wx:if="{{p}}" class="attendance-progress__footer"><text class="attendance-progress__footer-text">{{q}}</text></view></view>