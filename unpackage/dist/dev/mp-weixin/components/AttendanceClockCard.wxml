<view class="clock-card"><view class="clock-card__header"><text class="clock-card__title">课堂打卡</text><text class="clock-card__hint">{{a}}</text></view><view class="clock-card__row"><view class="{{['clock-card__step', f && 'is-done', g && 'is-active']}}"><view class="clock-card__step-dot"></view><view class="clock-card__step-body"><text class="clock-card__step-title">上课打卡</text><text wx:if="{{b}}" class="clock-card__step-time">{{c}}</text><text wx:else class="clock-card__step-time clock-card__step-time--muted"> 老师打卡后记录时间与位置 </text><text wx:if="{{d}}" class="clock-card__step-addr"> 位置：{{e}}</text></view></view><view class="{{['clock-card__line', h && 'is-done']}}"></view><view class="{{['clock-card__step', m && 'is-done', n && 'is-active']}}"><view class="clock-card__step-dot"></view><view class="clock-card__step-body"><text class="clock-card__step-title">下课打卡</text><text wx:if="{{i}}" class="clock-card__step-time">{{j}}</text><text wx:else class="clock-card__step-time clock-card__step-time--muted"> 完成上课打卡后可随时打卡 </text><text wx:if="{{k}}" class="clock-card__step-addr"> 位置：{{l}}</text></view></view></view><view class="clock-card__actions"><button wx:if="{{o}}" class="clock-card__btn clock-card__btn--primary" disabled="{{q}}" bindtap="{{r}}">{{p}}</button><button wx:if="{{s}}" class="clock-card__btn clock-card__btn--primary" disabled="{{v}}" bindtap="{{w}}">{{t}}</button><text wx:if="{{x}}" class="clock-card__done"> ✔ 本节课打卡已完成，等待家长确认与评价 </text></view></view>