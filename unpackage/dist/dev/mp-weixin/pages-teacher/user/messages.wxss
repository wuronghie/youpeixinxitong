/* CSS图标样式 */
.icon-empty.data-v-1e08efc7 {
	width: 240rpx;
	height: 240rpx;
	position: relative;
	display: inline-block;
	border: 4rpx dashed #ddd;
	border-radius: 20rpx;
}
.icon-empty.data-v-1e08efc7::before {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -60%);
	width: 60rpx;
	height: 60rpx;
	border: 4rpx solid #ddd;
	border-radius: 50%;
}
.icon-empty.data-v-1e08efc7::after {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -30%);
	width: 80rpx;
	height: 4rpx;
	background: #ddd;
}
.icon-bell.data-v-1e08efc7 {
	width: 48rpx;
	height: 48rpx;
	position: relative;
	display: inline-block;
	background: transparent;
	box-sizing: border-box;
	overflow: visible;
}
.icon-bell.data-v-1e08efc7::before {
	content: '';
	position: absolute;
	top: 4rpx;
	left: 50%;
	transform: translateX(-50%);
	width: 20rpx;
	height: 18rpx;
	border: 2rpx solid currentColor;
	border-radius: 10rpx 10rpx 2rpx 2rpx;
	background: transparent;
}
.icon-bell.data-v-1e08efc7::after {
	content: '';
	position: absolute;
	bottom: 2rpx;
	left: 50%;
	transform: translateX(-50%);
	width: 4rpx;
	height: 6rpx;
	border: 2rpx solid currentColor;
	border-top: none;
	border-radius: 0 0 4rpx 4rpx;
}
.icon-calendar.data-v-1e08efc7 {
	width: 48rpx;
	height: 48rpx;
	position: relative;
