
.list-scroll.data-v-d652b2bb {
	flex: 1;
	height: calc(100vh - 400rpx);
}

/* 选中状态的选项卡样式 */
.tab-active.data-v-d652b2bb {
	background-color: #FFFFFF;
	color: #07C160;
	font-weight: 600;
}

/* 未选中状态的选项卡样式 */
.tab-inactive.data-v-d652b2bb {
	background-color: rgba(255, 255, 255, 0.2);
	color: #FFFFFF;
}
.tabbar-spacer.data-v-d652b2bb {
	height: 140rpx;
}

/* 打卡徽章样式 */
.rounded-pill.data-v-d652b2bb {
	border-radius: 999rpx;
	font-size: 22rpx;
	white-space: nowrap;
}
.badge-danger.data-v-d652b2bb {
	background: #fee2e2;
	color: #b91c1c;
}
.badge-warning.data-v-d652b2bb {
	background: #fef3c7;
	color: #b45309;
}
.badge-success.data-v-d652b2bb {
	background: #d1fae5;
	color: #047857;
}
.badge-info.data-v-d652b2bb {
	background: #dbeafe;
	color: #1d4ed8;
}
.badge-muted.data-v-d652b2bb {
	background: #f3f4f6;
	color: #6b7280;
}

/* CSS图标样式 */
.icon-empty.data-v-d652b2bb {
	width: 240rpx;
	height: 240rpx;
	position: relative;
	display: inline-block;
	border: 4rpx dashed #ddd;
	border-radius: 20rpx;
	background: transparent;
	box-sizing: border-box;
	overflow: visible;
}
.icon-empty.data-v-d652b2bb::before {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -60%);
	width: 60rpx;
	height: 60rpx;
	border: 4rpx solid #ddd;
	border-radius: 50%;
}
.icon-empty.data-v-d652b2bb::after {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -30%);
	width: 80rpx;
	height: 4rpx;
	background: #ddd;
}
