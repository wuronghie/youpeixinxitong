
.chat-list-page.data-v-88a60026 {
	background: #EDEDED;
	min-height: 100vh;
}

/* 导航栏 */
.navbar.data-v-88a60026 {
	background: #FFFFFF;
	padding-top: var(--status-bar-height, 0);
}
.navbar-content.data-v-88a60026 {
	height: 88rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
}
.navbar-title.data-v-88a60026 {
	font-size: 36rpx;
	font-weight: 600;
	color: #000000;
}

/* 搜索框 */
.search-box.data-v-88a60026 {
	background: #FFFFFF;
	padding: 20rpx 30rpx;
}
.search-input-wrapper.data-v-88a60026 {
	background: #F7F7F7;
	border-radius: 10rpx;
	display: flex;
	align-items: center;
	padding: 0 30rpx;
	height: 72rpx;
}
.search-icon.data-v-88a60026 {
	font-size: 32rpx;
	color: #999999;
	margin-right: 20rpx;
}
.search-input.data-v-88a60026 {
	flex: 1;
	font-size: 28rpx;
	color: #333333;
}
.search-placeholder.data-v-88a60026 {
	color: #999999;
}
.clear-icon.data-v-88a60026 {
	font-size: 28rpx;
	color: #999999;
	margin-left: 20rpx;
}

/* 列表区域 */
.list-scroll.data-v-88a60026 {
	flex: 1;
	height: calc(100vh - 200rpx);
}

/* 会话项 */
.conversation-item.data-v-88a60026 {
	background: #FFFFFF;
	display: flex;
	align-items: center;
	padding: 24rpx 30rpx;
	border-bottom: 1rpx solid #EDEDED;
	position: relative;
}
.conversation-item.data-v-88a60026:active {
	background: #F5F5F5;
}
.avatar.data-v-88a60026 {
	width: 96rpx;
	height: 96rpx;
	border-radius: 8rpx;
	margin-right: 24rpx;
	flex-shrink: 0;
}
.content.data-v-88a60026 {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}
.header.data-v-88a60026 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 12rpx;
	min-height: 44rpx;
	max-height: 44rpx;
	flex-shrink: 0;
}
.name.data-v-88a60026 {
	font-size: 32rpx;
	font-weight: 500;
	color: #000000;
	flex: 1;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.time.data-v-88a60026 {
	font-size: 24rpx;
	color: #999999;
	margin-left: 20rpx;
	flex-shrink: 0;
}
.footer.data-v-88a60026 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 40rpx;
	max-height: 40rpx;
}
.message.data-v-88a60026 {
	font-size: 28rpx;
	color: #999999;
	flex: 1;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	line-height: 40rpx;
	max-height: 40rpx;
}
.message.unread.data-v-88a60026 {
	color: #000000;
	font-weight: 500;
}
.badge.data-v-88a60026 {
	background: #FA5151;
	color: #FFFFFF;
	font-size: 20rpx;
	min-width: 32rpx;
	height: 32rpx;
	border-radius: 16rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0 12rpx;
	margin-left: 16rpx;
	flex-shrink: 0;
}

/* 加载状态 */
.loading-wrapper.data-v-88a60026 {
	padding: 20rpx 0;
}
.skeleton.data-v-88a60026 {
	background: #FFFFFF;
}
.avatar-skeleton.data-v-88a60026 {
	width: 96rpx;
	height: 96rpx;
	border-radius: 8rpx;
	background: #F0F0F0;
	margin-right: 24rpx;
}
.content-skeleton.data-v-88a60026 {
	flex: 1;
}
.name-skeleton.data-v-88a60026 {
	width: 200rpx;
	height: 32rpx;
	background: #F0F0F0;
	border-radius: 4rpx;
	margin-bottom: 12rpx;
}
.message-skeleton.data-v-88a60026 {
	width: 300rpx;
	height: 28rpx;
	background: #F0F0F0;
	border-radius: 4rpx;
}

/* 空状态 */
.empty-state.data-v-88a60026 {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 200rpx 0;
}
.empty-icon.data-v-88a60026 {
	margin-bottom: 40rpx;
}

/* CSS图标样式 */
.icon-search.data-v-88a60026 {
	width: 40rpx;
	height: 40rpx;
	position: relative;
	display: inline-block;
	background: transparent;
	box-sizing: border-box;
	overflow: visible;
}
.icon-search.data-v-88a60026::before {
	content: '';
	position: absolute;
	top: 4rpx;
	left: 4rpx;
	width: 16rpx;
	height: 16rpx;
	border: 2rpx solid currentColor;
	border-radius: 50%;
	background: transparent;
}
.icon-search.data-v-88a60026::after {
	content: '';
	position: absolute;
	bottom: 4rpx;
	right: 4rpx;
	width: 12rpx;
	height: 2rpx;
	background: currentColor;
	transform: rotate(45deg);
	transform-origin: left center;
}
.icon-close.data-v-88a60026 {
	width: 40rpx;
	height: 40rpx;
	position: relative;
	display: inline-block;
	background: transparent;
	box-sizing: border-box;
	overflow: visible;
}
.icon-close.data-v-88a60026::before,
.icon-close.data-v-88a60026::after {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	width: 24rpx;
	height: 2rpx;
	background: currentColor;
}
.icon-close.data-v-88a60026::before {
	transform: translate(-50%, -50%) rotate(45deg);
}
.icon-close.data-v-88a60026::after {
	transform: translate(-50%, -50%) rotate(-45deg);
}
.icon-chat.data-v-88a60026 {
	width: 120rpx;
	height: 120rpx;
	position: relative;
	display: inline-block;
	background: transparent;
	box-sizing: border-box;
	overflow: visible;
}
.icon-chat.data-v-88a60026::before {
	content: '';
	position: absolute;
	bottom: 0;
	left: 0;
	width: 84rpx;
	height: 60rpx;
	border: 4rpx solid currentColor;
	border-radius: 12rpx 12rpx 12rpx 0;
	background: transparent;
}
.icon-chat.data-v-88a60026::after {
	content: '';
	position: absolute;
	bottom: 8rpx;
	left: 12rpx;
	width: 8rpx;
	height: 8rpx;
	background: currentColor;
	border-radius: 50%;
	box-shadow: 12rpx 0 0 currentColor, 24rpx 0 0 currentColor;
}
.empty-text.data-v-88a60026 {
	font-size: 32rpx;
	color: #999999;
	margin-bottom: 16rpx;
}
.empty-hint.data-v-88a60026 {
	font-size: 28rpx;
	color: #CCCCCC;
}
.loading-more.data-v-88a60026 {
	text-align: center;
	padding: 40rpx 0;
	font-size: 28rpx;
	color: #999999;
}
.tabbar-spacer.data-v-88a60026 {
	height: 140rpx;
}
