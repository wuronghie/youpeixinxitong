	display: flex;
	flex-direction: column;
	flex: 0 1 auto;
	min-width: 0;
	max-width: 70%;
}
.message-item:not(.message-right) .message-content-wrapper.data-v-83c710d1 {
	align-items: flex-start;
	margin-left: 20rpx;
	margin-right: 0;
}
.message-item.message-right .message-content-wrapper.data-v-83c710d1 {
	align-items: flex-end;
	margin-right: 20rpx;
	margin-left: 0;
}
.message-bubble.data-v-83c710d1 {
	padding: 18rpx 24rpx;
	border-radius: 10rpx;
	word-wrap: break-word;
	word-break: break-all;
	display: inline-block;
	position: relative;
	box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}
.bubble-left.data-v-83c710d1 {
	background: #FFFFFF;
	border-top-left-radius: 0;
	position: relative;
}
.bubble-left.data-v-83c710d1::before {
	content: '';
	position: absolute;
	left: -16rpx;
	top: 20rpx;
	width: 0;
	height: 0;
	border-top: 12rpx solid transparent;
	border-bottom: 12rpx solid transparent;
	border-right: 16rpx solid #FFFFFF;
}
.bubble-right.data-v-83c710d1 {
	background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
	border-top-right-radius: 0;
	position: relative;
}
.bubble-right.data-v-83c710d1::after {
	content: '';
	position: absolute;
	right: -16rpx;
	top: 20rpx;
	width: 0;
	height: 0;
	border-top: 12rpx solid transparent;
	border-bottom: 12rpx solid transparent;
	border-left: 16rpx solid;
	border-left-color: #357ABD;
}
.message-text.data-v-83c710d1 {
	font-size: 34rpx;
	line-height: 1.6;
}
.bubble-left .message-text.data-v-83c710d1 {
	color: #000000;
}
.bubble-right .message-text.data-v-83c710d1 {
	color: #FFFFFF;
}

