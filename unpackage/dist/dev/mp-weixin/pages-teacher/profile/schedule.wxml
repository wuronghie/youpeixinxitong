<view class="page data-v-fdc0b670"><scroll-view scroll-y class="scroll data-v-fdc0b670"><text class="form-tip data-v-fdc0b670">每天固定 3 段：09:00–11:00 / 14:00–16:00 / 19:00–21:00，点击切换开放。</text><view class="form-card data-v-fdc0b670"><view wx:for="{{a}}" wx:for-item="day" wx:key="e" class="day-block data-v-fdc0b670"><view class="day-head data-v-fdc0b670"><text class="day-name data-v-fdc0b670">{{day.a}}</text><text class="{{['day-summary', 'data-v-fdc0b670', day.c && 'off']}}">{{day.b}}</text></view><view class="slots data-v-fdc0b670"><text wx:for="{{day.d}}" wx:for-item="slot" wx:key="b" class="{{['slot', 'data-v-fdc0b670', slot.c && 'on']}}" bindtap="{{slot.d}}">{{slot.a}}</text></view></view></view><view class="section-card data-v-fdc0b670"><view class="section-head data-v-fdc0b670"><text class="section-title data-v-fdc0b670">不可预约日期</text><picker class="data-v-fdc0b670" mode="date" bindchange="{{b}}"><text class="section-more data-v-fdc0b670">+ 添加日期</text></picker></view><view wx:if="{{c}}" class="tags data-v-fdc0b670"><view wx:for="{{d}}" wx:for-item="date" wx:key="c" class="date-chip data-v-fdc0b670"><text class="data-v-fdc0b670">{{date.a}}</text><text class="date-x data-v-fdc0b670" bindtap="{{date.b}}">×</text></view></view><text wx:else class="empty data-v-fdc0b670">当前没有设定不可预约日期</text></view><view class="scroll-spacer data-v-fdc0b670"></view></scroll-view><view class="action-bar data-v-fdc0b670"><button class="save-btn data-v-fdc0b670" loading="{{e}}" bindtap="{{f}}">保存时间设置</button></view></view>