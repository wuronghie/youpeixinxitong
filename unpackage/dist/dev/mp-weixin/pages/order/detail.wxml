<view><view class="main-bg-color text-white p-4 d-flex a-end j-sb" style="height:300rpx"><view class="mb-3"><view class="font-lg font-weight">{{a}}</view><view class="font-sm mt-2" style="opacity:0.85">{{b}}</view></view><view class="iconfont icon-dingdan line-h mb-3" style="font-size:100rpx;opacity:0.3"></view></view><card wx:if="{{j}}" u-s="{{['d']}}" u-i="78ef3ab7-0" bind:__l="__l" u-p="{{j}}"><view class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">订单编号</text><text class="font-sm">{{c}}</text></view><view class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">订单类型</text><text class="font-sm">{{d}}</text></view><view class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">创建时间</text><text class="font-sm">{{e}}</text></view><view wx:if="{{f}}" class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">支付时间</text><text class="font-sm">{{g}}</text></view><view wx:if="{{h}}" class="d-flex a-center j-sb py-2"><text class="font-sm text-light-muted">退款时间</text><text class="font-sm">{{i}}</text></view></card><divider u-i="78ef3ab7-1" bind:__l="__l"></divider><card wx:if="{{r}}" u-s="{{['d']}}" u-i="78ef3ab7-2" bind:__l="__l" u-p="{{r}}"><view class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">订单金额</text><text class="font-sm main-text-color font-weight">¥{{k}}</text></view><view wx:if="{{l}}" class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">平台服务费</text><text class="font-sm">¥{{m}}</text></view><view wx:if="{{n}}" class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">教师收入</text><text class="font-sm">¥{{o}}</text></view><view wx:if="{{p}}" class="d-flex a-center j-sb py-2"><text class="font-sm text-light-muted">退款金额</text><text class="font-sm text-danger font-weight">¥{{q}}</text></view></card><divider u-i="78ef3ab7-3" bind:__l="__l"></divider><card wx:if="{{s}}" u-s="{{['d']}}" u-i="78ef3ab7-4" bind:__l="__l" u-p="{{z}}"><view class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">预约编号</text><text class="font-sm">{{t}}</text></view><view class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">教师</text><text class="font-sm">{{v}}</text></view><view class="d-flex a-center j-sb py-2"><text class="font-sm text-light-muted">上课时间</text><text class="font-sm">{{w}} {{x}}</text></view><view class="d-flex j-end mt-2 pt-2 border-top"><text class="main-text-color font-sm" bindtap="{{y}}">查看预约详情</text></view></card><divider u-i="78ef3ab7-5" bind:__l="__l"></divider><card wx:if="{{A}}" u-s="{{['d']}}" u-i="78ef3ab7-6" bind:__l="__l" u-p="{{D}}"><view class="d-flex a-center j-sb py-2 border-bottom"><text class="font-sm text-light-muted">支付方式</text><text class="font-sm">{{B}}</text></view><view class="d-flex a-center j-sb py-2"><text class="font-sm text-light-muted">订单流水号</text><text class="font-sm">{{C}}</text></view></card><divider u-i="78ef3ab7-7" bind:__l="__l"></divider><card wx:if="{{E}}" u-s="{{['d']}}" u-i="78ef3ab7-8" bind:__l="__l" u-p="{{I}}"><view wx:for="{{F}}" wx:for-item="step" wx:key="d" class="{{['d-flex', 'a-start', 'py-2', step.e && 'border-bottom']}}"><view class="{{['rounded-circle', 'mr-3', 'mt-1', step.a]}}" style="width:18rpx;height:18rpx"></view><view class="flex-1"><text class="font-sm d-block">{{step.b}}</text><text class="font-sm text-light-muted d-block mt-1">{{step.c}}</text></view></view><view wx:if="{{G}}" class="d-flex j-end mt-2 pt-2 border-top"><text class="main-text-color font-sm" bindtap="{{H}}">客服处理进度</text></view></card><divider u-i="78ef3ab7-9" bind:__l="__l"></divider><view wx:if="{{J}}" style="height:100rpx"></view><view wx:if="{{K}}" class="bg-white position-fixed bottom-0 left-0 right-0 d-flex a-center j-end px-3" style="height:100rpx;z-index:100"><button wx:if="{{L}}" class="main-bg-color text-white rounded px-4 py-2 font-sm mr-2" bindtap="{{M}}"> 确认课程完成 </button><button wx:if="{{N}}" class="main-bg-color text-white rounded px-4 py-2 font-sm mr-2" bindtap="{{O}}"> 写评价 </button><button wx:if="{{P}}" class="border border-warning text-warning rounded px-4 py-2 font-sm mr-2" bindtap="{{Q}}"> 异常情况申请退款 </button><button wx:if="{{R}}" class="main-bg-color text-white rounded px-4 py-2 font-sm" bindtap="{{S}}"> 立即支付 </button><button wx:if="{{T}}" class="border border-primary text-primary rounded px-4 py-2 font-sm" bindtap="{{U}}"> 联系客服 </button><button wx:if="{{V}}" class="border border-light-secondary text-light-muted rounded px-4 py-2 font-sm" disabled> 订单已退款 </button><button wx:if="{{W}}" class="border border-light-secondary text-light-muted rounded px-4 py-2 font-sm" disabled> 退款处理中 </button></view></view>