
.teacher-list-page.data-v-808011a9 {
	height: 100vh;
	display: flex;
	flex-direction: column;
	background: #f5f5f5;
	overflow: hidden;
}
.teacher-list-top.data-v-808011a9 {
	flex-shrink: 0;
	background: #f5f5f5;
	z-index: 20;
}
.search-header.data-v-808011a9 {
	flex-shrink: 0;
}

/* 顶部筛选栏（全部 / 科目 / 年级 / 排序） */
.filter-tabs.data-v-808011a9 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 10rpx 12rpx;
	margin: 0 24rpx 10rpx;
	background-color: #FFFFFF;
	border-radius: 20rpx;
	box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.04);
	overflow: hidden;
}
.filter-tab.data-v-808011a9 {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 1;
	min-width: 0;
	min-height: 56rpx;
	font-size: 23rpx;
	color: #666666;
	padding: 0 6rpx;
	position: relative;
	border-radius: 12rpx;
	background: transparent;
	box-sizing: border-box;
	overflow: hidden;
}
.filter-tab + .filter-tab.data-v-808011a9 {
	border-left: 1rpx solid #F5F5F5;
}
.filter-tab text.data-v-808011a9 {
	display: block;
	max-width: 100%;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.filter-tab.active.data-v-808011a9 {
	color: #F8A100;
	font-weight: 600;
}

/* 下拉筛选面板 */
.dropdown-mask.data-v-808011a9 {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.15);
	z-index: 1000;
}
.dropdown-panel.data-v-808011a9 {
	background-color: #FFFFFF;
	border-radius: 0 0 20rpx 20rpx;
	padding: 10rpx 0;
	box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}
.dropdown-list.data-v-808011a9 {
	padding: 10rpx 20rpx 20rpx;
}
.dropdown-section-title.data-v-808011a9 {
	font-size: 22rpx;
	color: #999999;
	padding: 16rpx 4rpx 8rpx;
}
.dropdown-item.data-v-808011a9 {
	padding: 18rpx 10rpx;
	font-size: 26rpx;
	color: #333333;
	border-bottom: 1rpx solid #F5F5F5;
}
.dropdown-item.data-v-808011a9:last-child {
	border-bottom: none;
}
.dropdown-item.active.data-v-808011a9 {
	color: #F8A100;
	font-weight: 600;
}

/* 单列教师列表滚动区域 */
.list-scroll-single.data-v-808011a9 {
	flex: 1;
	min-height: 0;
	background: #F5F5F5;
	padding-bottom: 140rpx;
}
.tabbar-spacer.data-v-808011a9 {
	height: 0;
}

/* 收藏按钮 */
.favorite-btn.data-v-808011a9 {
	position: absolute;
	top: 20rpx;
	right: 20rpx;
	z-index: 10;
	width: 60rpx;
	height: 60rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.favorite-btn .favorite-icon.data-v-808011a9 {
	width: 44rpx;
	height: 44rpx;
	transition: transform 0.2s ease;
}
.favorite-btn:active .favorite-icon.data-v-808011a9 {
	transform: scale(0.9);
}

/* 教师卡片动效与阴影 */
.teacher-card.data-v-808011a9 {
	border-radius: 24rpx;
	overflow: hidden;
	transform: translateY(0);
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
	transition: transform 0.18s ease-out, box-shadow 0.18s ease-out;
}
.teacher-card-hover.data-v-808011a9 {
	transform: translateY(-4rpx);
	box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.14);
}
.teacher-gender-chip.data-v-808011a9 {
	padding: 4rpx 14rpx;
	border-radius: 999rpx;
	font-size: 20rpx;
	line-height: 1.4;
	font-weight: 600;
}
.teacher-gender-chip.male.data-v-808011a9 {
	color: #1677ff;
	background: #e6f4ff;
}
.teacher-gender-chip.female.data-v-808011a9 {
	color: #eb2f96;
	background: #fff0f6;
}
