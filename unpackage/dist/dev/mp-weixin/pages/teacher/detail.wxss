	box-shadow: 0 20rpx 40rpx rgba(27, 72, 168, 0.18);
}
.avatar-shell.data-v-0cbe3d9e {
	width: 170rpx;
	height: 170rpx;
	padding: 8rpx;
	background: rgba(255,255,255,0.14);
	box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.12);
}
.hero-subtitle.data-v-0cbe3d9e {
	opacity: 0.9;
	line-height: 1.5;
}
.hero-metrics.data-v-0cbe3d9e {
	display: flex;
