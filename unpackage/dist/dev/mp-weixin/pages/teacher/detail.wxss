
.teacher-detail-page.data-v-0cbe3d9e {
	background: linear-gradient(180deg, #f7f9fc 0%, #f3f6fb 100%);
	min-height: 100vh;
}
.scroll.data-v-0cbe3d9e {
	flex: 1;
	height: calc(100vh - 500rpx);
	padding-bottom: 200rpx;
}
.page-content.data-v-0cbe3d9e {
	padding-bottom: 190rpx;
}
.detail-hero.data-v-0cbe3d9e {
