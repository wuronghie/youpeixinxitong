}
.hero-overlay.data-v-0cbe3d9e {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: radial-gradient(circle at top right, rgba(255,255,255,0.22), transparent 40%);
}
.hero-card.data-v-0cbe3d9e {
	padding: 28rpx;
	border-radius: 32rpx;
	background: rgba(255, 255, 255, 0.12);
